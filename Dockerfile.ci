# Self-contained CI build of the PasarGuard panel (WireGuard fork).
#
# Differs from the upstream ./Dockerfile only in that the dashboard is built
# *inside* the image (bun stage) instead of being passed as a pre-built CI
# artifact, so a single `docker build` produces a complete image.
#
# The published pasarguard-node-bridge wheel does NOT ship the WireGuard
# pre_shared_key field, so the bridge protobufs are regenerated below.
ARG PYTHON_VERSION=3.14

# 1. Dashboard (React/Vite) -> static assets in /dashboard/build
FROM oven/bun:1 AS dashboard-builder
WORKDIR /dashboard
COPY dashboard/package.json dashboard/bun.lock* ./
RUN bun install --frozen-lockfile
COPY dashboard/ ./
ENV VITE_BASE_API=/
RUN bun run build && cp ./build/index.html ./build/404.html

# 2. Python deps + project (uv), with the dashboard baked in
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc python3-dev libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
COPY . ./
COPY --from=dashboard-builder /dashboard/build ./dashboard/build
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev
# The published pasarguard-node-bridge wheel lacks the WireGuard pre_shared_key
# field; regenerate its protobufs from the vendored contract (proto/service.proto)
# so the panel can send PSK to patched nodes. Fails the build if PSK is missing.
RUN .venv/bin/pip install -q grpcio-tools \
    && BRIDGE_DIR="$(.venv/bin/python -c 'import os, PasarGuardNodeBridge.common.service_pb2 as m; print(os.path.dirname(m.__file__))')" \
    && .venv/bin/python -m grpc_tools.protoc -I proto \
        --python_out="$BRIDGE_DIR" --pyi_out="$BRIDGE_DIR" proto/service.proto \
    && .venv/bin/python -c "from PasarGuardNodeBridge.common.service_pb2 import Wireguard; assert any(f.name=='pre_shared_key' for f in Wireguard.DESCRIPTOR.fields), 'PSK field missing after regen'; print('bridge PSK OK')"

# 3. Runtime
FROM python:${PYTHON_VERSION}-slim-bookworm
COPY --from=builder /build /code
WORKDIR /code
ENV PATH="/code/.venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends curl openssl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /code/db_data
COPY cli_wrapper.sh /usr/bin/pasarguard-cli
COPY tui_wrapper.sh /usr/bin/pasarguard-tui
RUN sed -i 's/\r$//' /code/start.sh /code/healthcheck.sh \
        /usr/bin/pasarguard-cli /usr/bin/pasarguard-tui \
    && chmod +x /usr/bin/pasarguard-cli /usr/bin/pasarguard-tui \
        /code/healthcheck.sh /code/start.sh
EXPOSE 8000
ENTRYPOINT ["/code/start.sh"]
